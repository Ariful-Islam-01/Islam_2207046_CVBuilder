<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cv_builder.controllers.HomeController"
            prefWidth="600" prefHeight="400">

    <top>
        <Label text="CV Builder Application"
               style="-fx-font-size: 26px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER" />
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <Label text="Welcome! Create your professional CV easily."
                   style="-fx-font-size: 16px;" />

            <Button text="Create New CV" fx:id="createBtn"
                    style="-fx-font-size: 16px; -fx-padding: 10 20;" />
        </VBox>
    </center>
</BorderPane>
