<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cv_builder.controllers.FormController"
            prefWidth="800" prefHeight="600">

    <top>
        <Label text="Create Your CV"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="20">

                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <GridPane hgap="10" vgap="12">

                    <!-- Full Name -->
                    <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <!-- Email -->
                    <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <!-- Phone -->
                    <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <!-- Address -->
                    <Label text="Address:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="addressField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <!-- Education -->
                    <Label text="Education:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextArea fx:id="educationField" prefRowCount="4"
                              GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <!-- Skills -->
                    <Label text="Skills:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextArea fx:id="skillsField" prefRowCount="3"
                              GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <!-- Work Experience -->
                    <Label text="Work Experience:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextArea fx:id="experienceField" prefRowCount="4"
                              GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <!-- Projects -->
                    <Label text="Projects:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <TextArea fx:id="projectsField" prefRowCount="4"
                              GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Generate Button -->
                <Button text="Generate CV" fx:id="generateBtn"
                        style="-fx-font-size: 16px; -fx-padding: 10 20;" />
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
