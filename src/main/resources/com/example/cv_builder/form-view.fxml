<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.cv_builder.controllers.FormController"
            prefWidth="800" prefHeight="600">

    <top>
        <Label text="Create Your CV"
               style="-fx-font-size: 26px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <content>
                <VBox spacing="25">
                    <padding>
                        <Insets top="20" right="30" bottom="20" left="30"/>
                    </padding>

                    <!-- SECTION 1 — Personal Information -->
                    <Label text="Personal Information"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator/>

                    <GridPane hgap="15" vgap="12">

                        <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Address:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="addressField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>

                    <!-- SECTION 2 — Education -->
                    <Label text="Education"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <TextArea fx:id="educationField" prefRowCount="4"/>

                    <!-- SECTION 3 — Skills -->
                    <Label text="Skills"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <TextArea fx:id="skillsField" prefRowCount="4"/>

                    <!-- SECTION 4 — Work Experience -->
                    <Label text="Work Experience"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <TextArea fx:id="experienceField" prefRowCount="5"/>

                    <!-- SECTION 5 — Projects -->
                    <Label text="Projects"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <TextArea fx:id="projectsField" prefRowCount="5"/>

                    <HBox alignment="CENTER">
                        <Button text="Generate CV" fx:id="generateBtn"
                                style="-fx-font-size: 16px; -fx-padding: 10 25;" />
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
