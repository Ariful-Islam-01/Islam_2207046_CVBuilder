<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane prefHeight="600" prefWidth="800"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.cv_builder.controllers.SavedCVsController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
            <Button fx:id="backBtn" text="← Back" />
            <Label text="Saved CVs" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" padding="10">
            <TableView fx:id="table" prefHeight="480">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="nameCol" text="Name" prefWidth="200"/>
                    <TableColumn fx:id="emailCol" text="Email" prefWidth="220"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="refreshBtn" text="Refresh" />
                <Button fx:id="loadBtn" text="Load into Form" />
                <Button fx:id="deleteBtn" text="Delete" />
                <Button fx:id="exportBtn" text="Export Selected" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
