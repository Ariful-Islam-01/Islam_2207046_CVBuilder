<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="700" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cv_builder.controllers.PreviewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15" />
            </padding>

            <Button onAction="#goBack" text="← Back" />
            <Label text="CV Preview" style="-fx-font-size: 26px; -fx-font-weight: bold;" BorderPane.alignment="CENTER" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="20">
                <padding>
                    <Insets top="20" right="30" bottom="20" left="30" />
                </padding>

                <Label fx:id="nameLabel" style="-fx-font-size: 28px; -fx-font-weight: bold;" styleClass="cv-name"/>

                <HBox spacing="10">
                    <Label text="Email:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="section-label"/>
                    <Label fx:id="emailLabel"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Phone:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="section-label"/>
                    <Label fx:id="phoneLabel"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Address:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="section-label"/>
                    <Label fx:id="addressLabel"/>
                </HBox>



                <!-- EDUCATION -->
                <VBox spacing="10">
                    <Label text="Education" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <Label fx:id="educationLabel" wrapText="true"/>
                </VBox>



                <!-- SKILLS -->
                <VBox spacing="10">
                    <Label text="Skills" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <Label fx:id="skillsLabel" wrapText="true"/>
                </VBox>


                <!-- EXPERIENCE -->
                <VBox spacing="10">
                    <Label text="Experience" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <Label fx:id="experienceLabel" wrapText="true"/>
                </VBox>


                <!-- PROJECTS -->
                <VBox spacing="10">
                    <Label text="Projects" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator/>
                    <Label fx:id="projectsLabel" wrapText="true"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
