<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="700"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.cv_builder.controllers.PreviewController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
            <Button fx:id="backBtn" text="← Back" />
            <Label text="CV Preview" style="-fx-font-size: 26px; -fx-font-weight: bold;" />
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="editBtn" text="Edit" />
            <Button fx:id="saveBtn" text="Save" />
            <Button fx:id="exportBtn" text="Export JSON" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="18">
                <padding>
                    <Insets top="20" right="30" bottom="20" left="30" />
                </padding>

                <Label fx:id="nameLabel" style="-fx-font-size: 28px; -fx-font-weight: bold;" />

                <HBox spacing="10">
                    <Label text="Email:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="emailLabel"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Phone:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="phoneLabel"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Address:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="addressLabel"/>
                </HBox>

                <VBox spacing="8">
                    <Label text="Education" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator />
                    <Label fx:id="educationLabel" wrapText="true"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Skills" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator />
                    <Label fx:id="skillsLabel" wrapText="true"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Experience" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator />
                    <Label fx:id="experienceLabel" wrapText="true"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Projects" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Separator />
                    <Label fx:id="projectsLabel" wrapText="true"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
